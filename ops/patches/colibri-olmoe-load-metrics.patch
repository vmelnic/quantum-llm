+static uint64_t read_expert_weight(Model *m, st_tensor *t, void *out, int *used_direct) {
+    *used_direct = 0;
+    int dfd = g_direct ? st_direct_fd(&m->S, t->fd) : -1;
+    if (dfd < 0) {
+        st_pread_full(t->fd, out, t->nbytes, t->off, "pread expert weight");
+        if (g_expert_drop) posix_fadvise(t->fd, t->off, t->nbytes, POSIX_FADV_DONTNEED);
+        return (uint64_t)t->nbytes;
+    }
+
+    const int64_t align = 4096;
+    int64_t aligned_off = t->off & ~(align - 1);
+    int64_t prefix = t->off - aligned_off;
+    if (prefix < 0 || t->nbytes < 0 || prefix > INT64_MAX - t->nbytes - (align - 1)) {
+        fprintf(stderr, "invalid direct-I/O range for expert tensor\n"); exit(1); }
+    int64_t aligned_n = (prefix + t->nbytes + align - 1) & ~(align - 1);
+    struct stat sb;
+    if (fstat(t->fd, &sb) != 0 || aligned_off > sb.st_size ||
+        aligned_n > sb.st_size - aligned_off) {
+        st_pread_full(t->fd, out, t->nbytes, t->off, "pread expert weight tail fallback");
+        if (g_expert_drop) posix_fadvise(t->fd, t->off, t->nbytes, POSIX_FADV_DONTNEED);
+        return (uint64_t)t->nbytes;
+    }
+
+    void *raw = NULL;
+    if (posix_memalign(&raw, (size_t)align, (size_t)aligned_n) != 0 || !raw) {
+        fprintf(stderr, "aligned allocation failed for %lld-byte direct expert read\n",
+                (long long)aligned_n); exit(1); }
+    st_pread_full(dfd, raw, aligned_n, aligned_off, "direct pread expert weight");
+    memcpy(out, (char *)raw + prefix, (size_t)t->nbytes);
+    compat_aligned_free(raw);
+    *used_direct = 1;
+    return (uint64_t)aligned_n;
+}
