+static void preload_ram_cache(Model *m) {
+    if (!g_ramcache) return;
+    Cfg *c = &m->c;
+    double started = now_s();
+    printf("[RAMCACHE] Preloading %d experts x %d layers...\n",
+           c->n_experts, c->n_layers);
+    for (int layer = 0; layer < c->n_layers; layer++) {
+        for (int expert = 0; expert < c->n_experts; expert++) {
+            Slot *slot = NULL;
+            expert_get(m, layer, expert, &slot);
+            if (!slot || slot->eid != expert) {
+                fprintf(stderr, "[RAMCACHE] failed at layer=%d expert=%d\n", layer, expert);
+                exit(1);
+            }
+        }
+    }
+    uint64_t payload = m->expert_load_bytes;
+    double seconds = now_s() - started;
+    printf("[RAMCACHE] ready experts=%d payload_bytes=%llu load_seconds=%.3f rss_gb=%.3f\n",
+           c->n_layers * c->n_experts, (unsigned long long)payload, seconds, rss_gb());
+    /* Preload I/O is startup cost, not decode traffic. Keep it in the explicit
+     * line above and reset decode/cache counters for apples-to-apples metrics. */
+    m->clock = 0; m->hits = 0; m->miss = 0;
+    m->expert_loads = 0; m->expert_load_bytes = 0; m->expert_io_bytes = 0;
+    m->expert_direct_loads = 0; m->expert_direct_bytes = 0;
+}
