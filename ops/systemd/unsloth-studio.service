[Unit]
Description=Unsloth Studio local inference API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=UNSLOTH_SKIP_AUTOSTART=1
ExecStart=%h/.unsloth/studio/unsloth_studio/bin/unsloth studio -H 0.0.0.0 -p 8888 --parallel 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=120
KillMode=mixed

[Install]
WantedBy=default.target
