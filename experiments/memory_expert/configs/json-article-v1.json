{
  "schema_version": 1,
  "source": {
    "format": "json",
    "text_pointer": "/text",
    "metadata_pointers": {
      "domain": "/domain",
      "jurisdiction": "/jurisdiction"
    }
  },
  "identity": {
    "document_id_pointer": "/doc_id",
    "title_pointer": "/title",
    "language_pointer": "/lang",
    "generation_pointer": "/scraped_at"
  },
  "defaults": {
    "namespace": "legislation",
    "language": "und",
    "generation": "1",
    "acl": [
      "public"
    ]
  },
  "segmentation": {
    "section_kind": "article",
    "section_pattern": "^(?P<label>Articolul\\s+[0-9]+(?:[¹²³⁴⁵⁶⁷⁸⁹⁰]+)?\\.?[^\\n]*)$",
    "section_label_group": "label",
    "maximum_chars": 1200,
    "overlap_paragraphs": 1
  },
  "output": {
    "records_per_shard": 128
  }
}
