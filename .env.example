# Copy to .env. The local file is ignored by Git.
QUANTUM_LLM_REMOTE=user@gpu-host
QUANTUM_LLM_REMOTE_ROOT=C:/quantum-llm

# The selected model and its externally advertised generation limits.
CHAT_MODEL=deepseek-v4-flash
MODEL_MAX_CONTEXT=65536
MODEL_MAX_OUTPUT_TOKENS=8192
MODEL_PORT=8080
MODEL_SYNC_ON_START=1
MODEL_READY_TIMEOUT=600
MODEL_GENERATION_TIMEOUT_SECONDS=600

# Immutable model artifacts already present on the GPU host.
MODEL_DEEPSEEK_BUNDLE=C:/models/deepseek-v4-flash/worker-bundle-v3
MODEL_QWEN_CONTAINER=C:/models/qwen3-next-80b-expert-pack-int8

# Local interactive client. CHAT_MAX_TOKENS can independently request a lower
# per-turn ceiling, but must not exceed MODEL_MAX_OUTPUT_TOKENS.
CHAT_SSH=user@gpu-host
CHAT_BASE_URL=http://127.0.0.1:8080
CHAT_MAX_TOKENS=8192
CHAT_LOCAL_PORT=18080
CHAT_READY_TIMEOUT=30
CHAT_PYTHON=python3
CHAT_SHOW_STATS=1

# Required only when the API server was started with bearer authentication.
EXPERT_API_KEY=

# Bounded Memory Expert proof of concept. The frozen Qwen3-4B checkpoint is
# separate from the production Qwen3-Next and DeepSeek artifacts.
MEMORY_POW_STEPS=1024
MEMORY_POW_BATCH_SIZE=2
MEMORY_POW_GRADIENT_ACCUMULATION=16
MEMORY_POW_LEARNING_RATE=0.0002
MEMORY_POW_OPTIMIZER=adamw
MEMORY_POW_EVALUATION_LIMIT=16
MEMORY_POW_GATE_RANK=16
MEMORY_POW_GATE_ALPHA=32
MEMORY_POW_INJECTION_EVERY=1
MEMORY_POW_KNOWLEDGE_DROPOUT=0.2

# Generic real-data ingestion and Memory Expert querying. Source paths remain
# local configuration and are never committed or synchronized as source data.
MEMORY_DATASET_NAME=example-dataset
MEMORY_INGEST_SOURCE=/path/to/source.json
MEMORY_INGEST_CONFIG=experiments/memory_expert/configs/json-article-v1.json
MEMORY_SOURCE_URI=source://example/document
MEMORY_ENCODER_MODEL=BAAI/bge-m3
MEMORY_ENCODER_REVISION=5617a9f61b028005a4858fdac845db406aefb181
MEMORY_ENCODER_MAX_TOKENS=1024
MEMORY_ENCODER_BATCH_SIZE=16
MEMORY_RETRIEVAL_TOP_K=2
MEMORY_MAX_MEMORY_TOKENS=768
MEMORY_MAX_NEW_TOKENS=128
MEMORY_QUERY_LANGUAGE=
MEMORY_ADAPTER_CHECKPOINT=work/memory-expert-capability-natural-v1/memory-expert.pt
MEMORY_CAPABILITY_CORPUS=work/memory-capability/xquad-natural-v1.jsonl
MEMORY_CAPABILITY_STEPS=4096
MEMORY_CAPABILITY_BATCH_SIZE=2
MEMORY_CAPABILITY_GRADIENT_ACCUMULATION=16
MEMORY_CAPABILITY_LEARNING_RATE=0.0002
MEMORY_CAPABILITY_EVALUATION_LIMIT=30
MEMORY_CAPABILITY_GATE_RANK=16
MEMORY_CAPABILITY_GATE_ALPHA=32
MEMORY_CAPABILITY_KNOWLEDGE_DROPOUT=0.2
MEMORY_CAPABILITY_MEMORY_TOKENS=384
MEMORY_CAPABILITY_NEW_TOKENS=128
MEMORY_CAPABILITY_CACHE_BYTES=4294967296
MEMORY_CAPABILITY_OUTPUT_NAME=memory-expert-capability-natural-v1
