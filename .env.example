# Copy to .env. The local file is ignored by Git.
QUANTUM_LLM_REMOTE=user@gpu-host
QUANTUM_LLM_REMOTE_ROOT=D:/quantum-llm
MODEL_ROOT=D:/quantum-llm/work/models

# The selected model and its externally advertised generation limits.
CHAT_MODEL=qwen
MODEL_MAX_CONTEXT=262144
# Absolute output ceiling. The service clamps each request to the positions
# left after exact prompt tokenization and allocates KV progressively.
MODEL_MAX_OUTPUT_TOKENS=262143
MODEL_HOST=127.0.0.1
MODEL_PORT=8080
MODEL_SYNC_ON_START=1
MODEL_READY_TIMEOUT=600
MODEL_GENERATION_TIMEOUT_SECONDS=14400
# Large-context JSON requests can be substantially larger than their token
# count. This limit is enforced before parsing the body.
MODEL_MAX_BODY_MIB=16
# Applied only when the artifact declares image input.
MODEL_MAX_IMAGE_PIXELS=2097152
MODEL_MAX_IMAGE_PATCH_TOKENS=4096

# Universal worker resource contract for every artifact below MODEL_ROOT.
MODEL_RAM_CACHE_GIB=48
# Provider-visible ceiling for aliases whose registry policy is `fixed`.
# A `fit` alias instead measures free device memory after fixed CUDA organs,
# withholds maximum dynamic KV/logits plus 1 GiB emergency headroom, and gives
# only the remaining bytes to routed expert pages.
MODEL_VRAM_CACHE_GIB=12
# Optional in-process secondary CUDA tier. Providers use it only when the
# artifact exposes compatible independently routed expert pages. Device cache
# is per CUDA ordinal; host cache is one total carved from MODEL_RAM_CACHE_GIB.
# Use auto for compatible secondary-device discovery with single-GPU fallback,
# or an explicit ordinal list for fail-closed deployment validation.
MODEL_ACTIVE_EXPERT_DEVICES=
MODEL_ACTIVE_EXPERT_DEVICE_CACHE_GIB=0
MODEL_ACTIVE_EXPERT_HOST_CACHE_GIB=0
MODEL_WORKER_CAPACITY=1
MODEL_MAXIMUM_QUEUE=4
# Physical pool for compact Q4H target pages plus MTP page state. Exact KV
# formats may raise this to the artifact-declared exact minimum at startup.
MODEL_KV_CACHE_MIB=5136
MODEL_KV_PAGE_TOKENS=256
# Fallback for artifacts not present in ops/model-aliases.tsv. Published model
# aliases declare their required KV format independently; the two standard-FP4
# Qwen aliases select Q4H with artifact-declared MTP-4.
MODEL_KV_CACHE_DTYPE=artifact
MODEL_PLACEMENT_PROFILE=balanced
# CUDA-event phase attribution. Keep disabled during normal serving because
# the diagnostic collection synchronizes outstanding phase events.
MODEL_PROFILE_GPU_PHASES=0
# Opt-in bounded diagnostic. Generated text may contain project data.
MODEL_RAW_RESPONSE_TRACE_FILE=
# Exact retained continuations are persisted below MODEL_ROOT and evicted by
# byte-budgeted LRU/TTL. Set the GiB budget to 0 to disable the NVMe tier.
MODEL_SESSION_CACHE_GIB=64
MODEL_SESSION_CACHE_TTL_SECONDS=604800

# Local interactive client. CHAT_MAX_TOKENS can independently request a lower
# per-turn ceiling, but must not exceed MODEL_MAX_OUTPUT_TOKENS. This ceiling
# does not preallocate KV; only populated positions consume pages.
CHAT_BASE_URL=http://127.0.0.1:8080
CHAT_MAX_TOKENS=262143
CHAT_LOCAL_PORT=18080
CHAT_READY_TIMEOUT=30
CHAT_REQUEST_TIMEOUT_SECONDS=14460
CHAT_PYTHON=python3
CHAT_SHOW_STATS=1
# Interactive chat defaults to full reasoning; pass --thinking off per command
# when latency or a non-reasoning response is required.
CHAT_THINKING_LEVEL=xhigh

# Required only when the API server was started with bearer authentication.
EXPERT_API_KEY=
